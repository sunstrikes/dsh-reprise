{
  "workspace": ".workspace/feed",
  "interval_ms": 150,
  "metrics": { "primary": "auc", "objectives": { "auc": "up" } },
  "stop": { "max_rounds": 1 },
  "budget": { "candidate_gpu_hours": 0.5, "gpu_hours_limit": 0 },
  "rounds": {
    "metric": { "name": "auc", "direction": "higher", "contract_ref": "examples/feed-structure/metric-contract.json" },
    "max_rounds": 1,
    "candidates_per_round": 2,
    "retry": { "base_ms": 1000, "max_ms": 4000, "max_attempts": 3 }
  },
  "executor": {
    "kind": "local",
    "command": ["node", "metric.mjs"],
    "root_dir": "jobs",
    "metrics_required": true
  },
  "candidate": {
    "kind": "command",
    "command": ["node", "examples/feed-structure/apply-change.mjs", "{candidate}", "examples/feed-structure/hypotheses.json"],
    "timeout_ms": 60000,
    "env": {}
  },
  "runner": { "repo": "model-repo", "base_ref": "HEAD", "dir": "worktrees" },
  "model": {
    "command": [
      "node",
      "examples/feed-structure/recorded-model.mjs",
      "examples/feed-structure/hypotheses.json",
      "examples/feed-structure/recorded/judgement.json",
      "examples/feed-structure/priors.json"
    ]
  },
  "poll": { "base_ms": 200, "max_ms": 2000, "grace_attempts": 2 },
  "limits": { "max_wall_ms": 120000, "max_idle_ms": 120000 }
}